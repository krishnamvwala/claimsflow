{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimsflow.example/schemas/local-ingestion-report.schema.json",
  "title": "ClaimsFlow local synthetic ingestion report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "synthetic_only",
    "decision",
    "ingested_at_utc",
    "source_manifest_sha256",
    "files",
    "artifact_inventory",
    "reconciliation",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id": { "type": "string", "pattern": "^CF-[0-9]{6}-[0-9A-F]{12}$" },
    "synthetic_only": { "const": true },
    "decision": { "enum": ["processed", "duplicate_no_op"] },
    "ingested_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/file" }
    },
    "artifact_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactEvidence" }
    },
    "reconciliation": { "$ref": "#/$defs/reconciliation" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "nullablePath": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_size": { "type": "integer", "minimum": 0 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity",
        "source_family",
        "dataset",
        "source_system",
        "file_name",
        "checksum_sha256",
        "contract_id",
        "contract_version",
        "declared_rows",
        "decision",
        "duplicate_of_batch_id",
        "counts",
        "artifacts"
      ],
      "properties": {
        "source_identity": { "type": "string", "pattern": "^[a-z-]+(\\.[a-z-]+)?$" },
        "source_family": { "type": "string", "pattern": "^[a-z-]+$" },
        "dataset": { "type": ["string", "null"], "pattern": "^[a-z-]+$" },
        "source_system": { "type": "string", "pattern": "^synthetic_[a-z_]+$" },
        "file_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.csv$" },
        "checksum_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contract_id": { "type": "string", "pattern": "^SRC-[A-Z]{3}-[0-9]{3}$" },
        "contract_version": { "const": "1.0.0" },
        "declared_rows": { "type": "integer", "minimum": 0 },
        "decision": { "enum": ["processed", "duplicate_no_op"] },
        "duplicate_of_batch_id": {
          "type": ["string", "null"],
          "pattern": "^CF-[0-9]{6}-[0-9A-F]{12}$"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "accepted", "warned", "quarantined", "rejected", "reconciled"],
          "properties": {
            "raw": { "type": "integer", "minimum": 0 },
            "accepted": { "type": "integer", "minimum": 0 },
            "warned": { "type": "integer", "minimum": 0 },
            "quarantined": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 },
            "reconciled": { "const": true }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["landing", "raw", "quality", "quarantine", "rejected"],
          "properties": {
            "landing": { "$ref": "#/$defs/nullablePath" },
            "raw": { "$ref": "#/$defs/nullablePath" },
            "quality": { "$ref": "#/$defs/nullablePath" },
            "quarantine": { "$ref": "#/$defs/nullablePath" },
            "rejected": { "$ref": "#/$defs/nullablePath" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "duplicate_no_op" } } },
          "then": {
            "properties": {
              "duplicate_of_batch_id": { "type": "string" },
              "counts": {
                "properties": {
                  "raw": { "const": 0 },
                  "accepted": { "const": 0 },
                  "warned": { "const": 0 },
                  "quarantined": { "const": 0 },
                  "rejected": { "const": 0 }
                }
              },
              "artifacts": {
                "properties": {
                  "landing": { "type": "null" },
                  "raw": { "type": "null" },
                  "quality": { "type": "null" },
                  "quarantine": { "type": "null" },
                  "rejected": { "type": "null" }
                }
              }
            }
          },
          "else": {
            "properties": {
              "duplicate_of_batch_id": { "type": "null" },
              "artifacts": {
                "properties": {
                  "landing": { "type": "string" },
                  "raw": { "type": "string" },
                  "quality": { "type": "string" },
                  "quarantine": { "type": "string" },
                  "rejected": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_rows",
        "raw_rows",
        "duplicate_no_op_rows",
        "accepted",
        "warned",
        "quarantined",
        "rejected",
        "disposition_rows",
        "reconciled"
      ],
      "properties": {
        "declared_rows": { "type": "integer", "minimum": 0 },
        "raw_rows": { "type": "integer", "minimum": 0 },
        "duplicate_no_op_rows": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "warned": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "disposition_rows": { "type": "integer", "minimum": 0 },
        "reconciled": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "duplicate_no_op" } } },
      "then": {
        "properties": {
          "files": {
            "items": { "properties": { "decision": { "const": "duplicate_no_op" } } }
          },
          "reconciliation": {
            "properties": {
              "raw_rows": { "const": 0 },
              "accepted": { "const": 0 },
              "warned": { "const": 0 },
              "quarantined": { "const": 0 },
              "rejected": { "const": 0 },
              "disposition_rows": { "const": 0 }
            }
          }
        }
      },
      "else": {
        "properties": {
          "files": { "contains": { "properties": { "decision": { "const": "processed" } } } }
        }
      }
    }
  ]
}
